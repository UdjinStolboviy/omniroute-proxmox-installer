# OmniRoute Configuration Environment Variables

# --- Required Security Secrets (Auto-generated on Install) ---
JWT_SECRET=__JWT_SECRET__
API_KEY_SECRET=__API_KEY_SECRET__
STORAGE_ENCRYPTION_KEY=__STORAGE_ENCRYPTION_KEY__
INITIAL_PASSWORD=__INITIAL_PASSWORD__

# --- Network Ports ---
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128,__LXC_ORIGIN__

# --- Global Configurations ---
DATA_DIR=/app/data
REQUIRE_API_KEY=true
INPUT_SANITIZER_ENABLED=true
